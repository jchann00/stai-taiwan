# ==============================================================================
# PayPal API Configuration
# https://developer.paypal.com 에서 Sandbox 앱 생성 후 자격 증명을 입력하세요.
# ==============================================================================

# PayPal Developer Dashboard에서 발급받은 Client ID & Secret
PAYPAL_CLIENT_ID=YOUR_PAYPAL_CLIENT_ID
PAYPAL_CLIENT_SECRET=YOUR_PAYPAL_CLIENT_SECRET

# 환경 설정: 'sandbox' (테스트) 또는 'production'/'live' (실결제)
PAYPAL_ENVIRONMENT=sandbox

# 서버 포트
PORT=3000
